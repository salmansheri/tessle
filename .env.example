# Copy to .env (git-ignored) and export before running the backend, e.g. `set -a; source .env; set +a`.
# Resend SMTP password = your Resend API key.
RESEND_SMTP_PASSWORD=
# Until a domain is verified in Resend, only onboarding@resend.dev -> your own account email works.
MAIL_FROM=onboarding@resend.dev
# Set to send one real test email at startup, then unset.
TESSLE_MAIL_SMOKE_TO=

# Required, at least 32 bytes each; the app refuses to start without them.
# Generate with: openssl rand -base64 48
TESSLE_JWT_SECRET=
TESSLE_OTP_SECRET=
# Cookies are Secure by default. Browsers accept them on http://localhost; set false only for curl over plain http.
TESSLE_COOKIES_SECURE=true

# Where links in emails (invitations) point. Defaults to the local frontend.
TESSLE_PUBLIC_URL=http://localhost:3000
