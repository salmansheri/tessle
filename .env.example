# Copy to .env (git-ignored) and export before running the backend, e.g. `set -a; source .env; set +a`.
# Resend SMTP password = your Resend API key.
RESEND_SMTP_PASSWORD=
# Until a domain is verified in Resend, only onboarding@resend.dev -> your own account email works.
MAIL_FROM=onboarding@resend.dev
# Set to send one real test email at startup, then unset.
TESSLE_MAIL_SMOKE_TO=
