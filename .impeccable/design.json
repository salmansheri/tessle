  "narrative": {
    "northStar": "Monochrome Proof",
    "overview": "A neutral scale carries the whole interface and one vermilion accent is spent rarely. Frosted glass gives the shell its depth over a near-neutral, cool-tinted ambient mesh. Both themes are first-class. The signature is the proof line: a claim paired with the fact that proves it.",
    "keyCharacteristics": [
      "Two real themes, set before first paint.",
      "Glass for shell and overlays; near-opaque glass for data tables.",
      "One accent for primary action, focus and current location.",
      "Geist at tight tracking with tabular figures.",
      "One soft rise on entry; reduced motion and transparency honoured."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "The accent is the only chromatic colour in the chrome. If a second hue is needed for meaning, it is a status pair with text, not decoration.",
        "section": "colors"
      },
      {
        "name": "The Cool Mesh Rule",
        "body": "The ambient mesh stays near-neutral and cool (three radial lobes, hue 250-262). No warm or teal washes.",
        "section": "colors"
      },
      {
        "name": "The Two Weights Rule",
        "body": "400 for reading, 600 for naming. No other weights.",
        "section": "typography"
      },
      {
        "name": "The Opaque Data Rule",
        "body": "Tables and popover menus use the strong glass fill. Figures must keep contrast; frost is for chrome.",
        "section": "elevation"
      },
      {
        "name": "The Fallback Rule",
        "body": "Under prefers-reduced-transparency: reduce, or where backdrop-filter is unsupported, glass and strong glass collapse to solid surface and blur to none.",
        "section": "elevation"
      },
      {
        "name": "The Unprefixed Blur Rule",
        "body": "Write only the unprefixed backdrop-filter in CSS. Next's CSS optimizer drops the property when a -webkit- form is authored, and Chromium ignores the prefixed form, so the glass silently vanishes.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do define every colour for both themes and check AA in each.",
      "Do pair every status or role colour with a word.",
      "Do use the strong glass fill for anything that carries data.",
      "Do keep new screens behind the proof-line pattern: title, proof line, actions, content.",
      "Do author backdrop-filter unprefixed only.",
      "Do honour reduced motion and reduced transparency in anything new."
    ],
    "donts": [
      "Don't add a second accent hue or gradient fills on buttons.",
      "Don't build card-grid dashboards; use tables and proof lines.",
      "Don't put warm or teal washes into the ambient mesh.",
      "Don't put body text on thin glass.",
      "Don't introduce weights other than 400 and 600."
    ]
  }
