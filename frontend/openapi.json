{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "paths" : {
    "/api/workspaces" : {
      "get" : {
        "tags" : [ "workspace-controller" ],
        "summary" : "The Workspaces the caller belongs to",
        "operationId" : "listWorkspaces",
        "responses" : {
          "200" : {
            "description" : "The caller's Workspaces",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/WorkspaceResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "workspace-controller" ],
        "summary" : "Create a Workspace; the caller becomes its owner and it becomes active",
        "operationId" : "createWorkspace",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateWorkspace"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created; the access cookie is renewed with the new active Workspace",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid name",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/{id}/activate" : {
      "post" : {
        "tags" : [ "workspace-controller" ],
        "summary" : "Switch the session's active Workspace",
        "operationId" : "activateWorkspace",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Switched; the access cookie is renewed"
          },
          "404" : {
            "description" : "Not a Workspace the caller belongs to"
          },
          "401" : {
            "description" : "The session has ended"
          }
        }
      }
    },
    "/api/auth/refresh" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Rotate the refresh token and renew the session cookies",
        "operationId" : "refreshSession",
        "responses" : {
          "204" : {
            "description" : "New cookies set"
          },
          "401" : {
            "description" : "Refresh token missing, expired, revoked or reused"
          }
        }
      }
    },
    "/api/auth/otp/verify" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Exchange an emailed code for a session",
        "operationId" : "verifyOtp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OtpVerification"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Signed in; session cookies set",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Malformed email or code",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Invalid, expired or used code",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "429" : {
            "description" : "Rate limited",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/otp/request" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Email a sign-in code (202 whether or not the email has an account)",
        "operationId" : "requestOtp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OtpRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Code emailed (or silently ignored for unknown addresses)"
          },
          "400" : {
            "description" : "Malformed email"
          },
          "429" : {
            "description" : "Rate limited"
          }
        }
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "End the current session",
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "Session ended; cookies cleared"
          },
          "401" : {
            "description" : "Not signed in"
          }
        }
      }
    },
    "/api/auth/logout-all" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "End every session of the signed-in user",
        "operationId" : "logoutEverywhere",
        "responses" : {
          "204" : {
            "description" : "All sessions ended; cookies cleared"
          },
          "401" : {
            "description" : "Not signed in"
          }
        }
      }
    },
    "/api/health" : {
      "get" : {
        "tags" : [ "health-controller" ],
        "summary" : "Liveness check",
        "operationId" : "getHealth",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me" : {
      "get" : {
        "tags" : [ "auth-controller" ],
        "summary" : "The signed-in user",
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "description" : "The signed-in user",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Not signed in",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf" : {
      "get" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Start a CSRF double-submit exchange",
        "operationId" : "getCsrf",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CsrfResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateWorkspace" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          }
        },
        "required" : [ "name" ]
      },
      "WorkspaceResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "description" : "The caller's role in this Workspace"
          }
        },
        "required" : [ "id", "name", "role" ]
      },
      "OtpVerification" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "minLength" : 1
          },
          "code" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "\\d{6}"
          }
        },
        "required" : [ "code", "email" ]
      },
      "UserResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : "string"
          },
          "activeWorkspaceId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "The Workspace the session is acting in, if one has been chosen"
          }
        },
        "required" : [ "email", "id" ]
      },
      "OtpRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "minLength" : 1
          }
        },
        "required" : [ "email" ]
      },
      "HealthResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string"
          }
        },
        "required" : [ "status" ]
      },
      "CsrfResponse" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string"
          }
        },
        "required" : [ "token" ]
      }
    }
  }
}
