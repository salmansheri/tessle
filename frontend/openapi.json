{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "paths" : {
    "/api/workspaces" : {
      "get" : {
        "tags" : [ "workspace-controller" ],
        "summary" : "The Workspaces the caller belongs to",
        "operationId" : "listWorkspaces",
        "responses" : {
          "200" : {
            "description" : "The caller's Workspaces",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/WorkspaceResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "workspace-controller" ],
        "summary" : "Create a Workspace; the caller becomes its owner and it becomes active",
        "operationId" : "createWorkspace",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateWorkspace"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created; the access cookie is renewed with the new active Workspace",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid name",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/{id}/activate" : {
      "post" : {
        "tags" : [ "workspace-controller" ],
        "summary" : "Switch the session's active Workspace",
        "operationId" : "activateWorkspace",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Switched; the access cookie is renewed"
          },
          "404" : {
            "description" : "Not a Workspace the caller belongs to"
          },
          "401" : {
            "description" : "The session has ended"
          }
        }
      }
    },
    "/api/invitations" : {
      "get" : {
        "tags" : [ "invitations-controller" ],
        "summary" : "Pending invitations of the active Workspace",
        "operationId" : "listInvitations",
        "responses" : {
          "200" : {
            "description" : "Pending invitations",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/InvitationResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "invitations-controller" ],
        "summary" : "Email an invitation to join the active Workspace",
        "operationId" : "inviteMember",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/InviteRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Invitation sent",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InvitationResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Not allowed",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InvitationResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Already a member, or a pending owner invitation exists",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InvitationResponse"
                }
              }
            }
          },
          "429" : {
            "description" : "Too many invitations sent recently",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InvitationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/invitations/accept" : {
      "post" : {
        "tags" : [ "invitations-controller" ],
        "summary" : "Accept an invitation; the signed-in email must match the invited one",
        "operationId" : "acceptInvitation",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AcceptRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Joined; the joined Workspace becomes active",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AcceptedResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "Unknown, used, expired, or meant for someone else",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AcceptedResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Rotate the refresh token and renew the session cookies",
        "operationId" : "refreshSession",
        "responses" : {
          "204" : {
            "description" : "New cookies set"
          },
          "401" : {
            "description" : "Refresh token missing, expired, revoked or reused"
          }
        }
      }
    },
    "/api/auth/otp/verify" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Exchange an emailed code for a session",
        "operationId" : "verifyOtp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OtpVerification"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Signed in; session cookies set",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Malformed email or code",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Invalid, expired or used code",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "429" : {
            "description" : "Rate limited",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/otp/request" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Email a sign-in code (202 whether or not the email has an account)",
        "operationId" : "requestOtp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OtpRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Code emailed (or silently ignored for unknown addresses)"
          },
          "400" : {
            "description" : "Malformed email"
          },
          "429" : {
            "description" : "Rate limited"
          }
        }
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "End the current session",
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "Session ended; cookies cleared"
          },
          "401" : {
            "description" : "Not signed in"
          }
        }
      }
    },
    "/api/auth/logout-all" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "End every session of the signed-in user",
        "operationId" : "logoutEverywhere",
        "responses" : {
          "204" : {
            "description" : "All sessions ended; cookies cleared"
          },
          "401" : {
            "description" : "Not signed in"
          }
        }
      }
    },
    "/api/apps" : {
      "get" : {
        "tags" : [ "apps-controller" ],
        "summary" : "Apps in the active Workspace",
        "operationId" : "listApps",
        "responses" : {
          "200" : {
            "description" : "The Apps",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AppResponse"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "No active workspace",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AppResponse"
                  }
                }
              }
            }
          },
          "403" : {
            "description" : "Not a member of the active workspace",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AppResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "apps-controller" ],
        "summary" : "Create an App (builders, admins and owners)",
        "operationId" : "createApp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateApp"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "No active workspace, or an invalid name",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "The caller's role cannot create Apps",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/{userId}" : {
      "delete" : {
        "tags" : [ "members-controller" ],
        "summary" : "Remove a member (owners and admins; only owners remove owners)",
        "operationId" : "removeMember",
        "parameters" : [ {
          "name" : "userId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Removed"
          },
          "403" : {
            "description" : "Not allowed"
          },
          "404" : {
            "description" : "Not a member"
          },
          "409" : {
            "description" : "The workspace would be left without an owner"
          }
        }
      },
      "patch" : {
        "tags" : [ "members-controller" ],
        "summary" : "Change a member's role (owners and admins; only owners touch owners)",
        "operationId" : "changeMemberRole",
        "parameters" : [ {
          "name" : "userId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChangeRole"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Changed"
          },
          "403" : {
            "description" : "Not allowed"
          },
          "404" : {
            "description" : "Not a member"
          },
          "409" : {
            "description" : "The workspace would be left without an owner"
          }
        }
      }
    },
    "/api/members" : {
      "get" : {
        "tags" : [ "members-controller" ],
        "summary" : "Members of the active Workspace",
        "operationId" : "listMembers",
        "responses" : {
          "200" : {
            "description" : "The members",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/MemberResponse"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "No active workspace",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/MemberResponse"
                  }
                }
              }
            }
          },
          "403" : {
            "description" : "Not a member of the active workspace",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/MemberResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health" : {
      "get" : {
        "tags" : [ "health-controller" ],
        "summary" : "Liveness check",
        "operationId" : "getHealth",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me" : {
      "get" : {
        "tags" : [ "auth-controller" ],
        "summary" : "The signed-in user",
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "description" : "The signed-in user",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Not signed in",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf" : {
      "get" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Start a CSRF double-submit exchange",
        "operationId" : "getCsrf",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CsrfResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/invitations/{id}" : {
      "delete" : {
        "tags" : [ "invitations-controller" ],
        "summary" : "Withdraw a pending invitation",
        "operationId" : "revokeInvitation",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Withdrawn"
          },
          "403" : {
            "description" : "Only owners can withdraw an owner invitation"
          },
          "404" : {
            "description" : "No such pending invitation"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateWorkspace" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0,
            "pattern" : "^(?=.*[^\\p{Z}\\s\\p{C}])[^\\p{Cntrl}\\u0080-\\u009f]*$"
          }
        },
        "required" : [ "name" ]
      },
      "WorkspaceResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "description" : "The caller's role in this Workspace"
          }
        },
        "required" : [ "id", "name", "role" ]
      },
      "InviteRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "minLength" : 1
          },
          "role" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "owner|admin|builder|editor|viewer"
          }
        },
        "required" : [ "email", "role" ]
      },
      "InvitationResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string"
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "email", "expiresAt", "id", "role" ]
      },
      "AcceptRequest" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "token" ]
      },
      "AcceptedResponse" : {
        "type" : "object",
        "properties" : {
          "workspaceId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "role" : {
            "type" : "string"
          }
        },
        "required" : [ "role", "workspaceId" ]
      },
      "OtpVerification" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "minLength" : 1
          },
          "code" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "\\d{6}"
          }
        },
        "required" : [ "code", "email" ]
      },
      "UserResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : "string"
          },
          "activeWorkspaceId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "The Workspace the session is acting in, if one has been chosen"
          }
        },
        "required" : [ "email", "id" ]
      },
      "OtpRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "minLength" : 1
          }
        },
        "required" : [ "email" ]
      },
      "CreateApp" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0,
            "pattern" : "^(?=.*[^\\p{Z}\\s\\p{C}])[^\\p{Cntrl}\\u0080-\\u009f]*$"
          }
        },
        "required" : [ "name" ]
      },
      "AppResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "createdAt", "id", "name" ]
      },
      "ChangeRole" : {
        "type" : "object",
        "properties" : {
          "role" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "owner|admin|builder|editor|viewer"
          }
        },
        "required" : [ "role" ]
      },
      "MemberResponse" : {
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "owner", "admin", "builder", "editor", "viewer" ]
          }
        },
        "required" : [ "email", "role", "userId" ]
      },
      "HealthResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string"
          }
        },
        "required" : [ "status" ]
      },
      "CsrfResponse" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string"
          }
        },
        "required" : [ "token" ]
      }
    }
  }
}
